SENTINEL_ENV=dev
SENTINEL_LOG_LEVEL=INFO
SENTINEL_AUTH_MODE=demo
SENTINEL_JWT_ISSUER=http://localhost:8080/realms/mcp-sentinel
SENTINEL_JWT_AUDIENCE=mcp-sentinel
SENTINEL_JWT_ALGORITHMS=RS256
SENTINEL_DEMO_JWT_SECRET=change-me-demo-only-not-for-production
SENTINEL_OIDC_JWKS_URL=http://localhost:8080/realms/mcp-sentinel/protocol/openid-connect/certs
SENTINEL_OIDC_CLIENT_ID=mcp-sentinel
# SENTINEL_DATABASE_URL=sqlite:////absolute/path/sentinel.db   (default: sentinel.db in the project folder)
SENTINEL_REDIS_URL=

# Network exposure (local-first; DNS-rebinding defences)
SENTINEL_GATEWAY_HOST=127.0.0.1
SENTINEL_GATEWAY_PORT=8443
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1,::1,[::1],sentinel,host.docker.internal,testserver
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8443
SENTINEL_DEMO_TOKEN_LOOPBACK_ONLY=true
# SENTINEL_PUBLIC_URL=http://localhost:8443
# SENTINEL_DASHBOARD_URL=http://localhost:5173

# Risk thresholds (hard policy always wins)
SENTINEL_RESTRICT_RISK_THRESHOLD=40
SENTINEL_MFA_RISK_THRESHOLD=60
SENTINEL_BLOCK_RISK_THRESHOLD=80
SENTINEL_RISK_ALPHA=0.5
SENTINEL_RISK_MEMORY_HALF_LIFE_SECONDS=600

# Leases, MFA, approvals
SENTINEL_LEASE_DEFAULT_SECONDS=120
SENTINEL_WORKFLOW_TTL_SECONDS=1800
SENTINEL_MFA_TTL_SECONDS=300
SENTINEL_APPROVAL_TTL_SECONDS=600
SENTINEL_APPROVAL_WAIT_SECONDS=50
# SENTINEL_ALLOW_SELF_APPROVAL=   (default: allowed only in demo mode)

# Upstream MCP servers / rug-pull detection
SENTINEL_ALLOW_STDIO_SERVERS=true
SENTINEL_DISCOVERY_INTERVAL_SECONDS=60
SENTINEL_JIT_INTEGRITY_SECONDS=15
SENTINEL_AUTO_PIN_CLEAN_TOOLS=true
SENTINEL_PROCESS_MONITOR_ENABLED=true
SENTINEL_UPSTREAM_TIMEOUT_SECONDS=45
SENTINEL_UPSTREAM_CONNECT_TIMEOUT_SECONDS=90
SENTINEL_SCAN_ON_REGISTER=true

# Data flow
SENTINEL_INTERNAL_DOMAINS=internal,local,localhost,lan,corp,home.arpa,svc,cluster.local
SENTINEL_ALLOWED_EGRESS_DOMAINS=
SENTINEL_DLP_REDACT_OUTPUTS=true

# Keys (generated on first start; keep them out of git)
# SENTINEL_SECRETS_KEY_FILE=./keys/sentinel.key
# SENTINEL_RECEIPT_KEY_FILE=./keys/receipt_ed25519.pem

